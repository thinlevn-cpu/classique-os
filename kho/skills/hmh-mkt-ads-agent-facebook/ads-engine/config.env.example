# =============================================================================
# config.env  —  CẤU HÌNH RIÊNG CỦA BẠN (Ads Agent self-serve)
# -----------------------------------------------------------------------------
# 1) Copy file này thành  config.env   (bỏ đuôi .example)
# 2) Điền 4 giá trị Lark + 1 dòng Meta ở MỤC A và C bên dưới.
# 3) Chạy:  node do-config.mjs        -> tự dò & điền hết các table_id (MỤC B).
# KHÔNG commit config.env lên git / KHÔNG gửi cho ai (chứa token của bạn).
# =============================================================================

# ===== A. LARK BASE (bạn điền tay) ==========================================
# base_token: mở Base "Ads Agent" của BẠN, lấy chuỗi trong URL .../base/<TOKEN>
B=DIEN_BASE_TOKEN_CUA_BAN

# DOMAIN Lark của bạn (phần trước /base/ trong URL). Mặc định bản quốc tế:
DOMAIN=https://example.sg.larksuite.com

# CHAT: open_chat_id nhóm Lark nhận thẻ duyệt/cảnh báo (dạng oc_xxx).
# Lấy bằng: skill lark-im, hoặc whoami.mjs trong gói cầu nối Lark. Để trống = không gửi thẻ.
CHAT=oc_DIEN_CHAT_ID_CUA_BAN

# ===== B. TABLE IDs (do-config.mjs tự điền — ĐỪNG sửa tay) ===================
T0=          # 0. Tổng tư lệnh
T1=          # 1. Chiến dịch
T2=          # 2. Nhóm quảng cáo
T3=          # 3. Quảng cáo / Creative
T4=          # 4. Tệp đối tượng
T5=          # 5. Số liệu hằng ngày
T7=          # 7. Thư viện URL đích
T9=          # 9. Pixel (Meta)
T_NK=        # 6. Nhật ký quyết định

# ===== C. META (Facebook Ads) ===============================================
# Token + ad account để TRONG file .secrets/meta-ads.env (xem meta-ads.env.example).
# Riêng ACT lặp lại ở đây CHỈ để dựng link Ads Manager trong thẻ báo cáo:
ACT=DIEN_AD_ACCOUNT_SO   # chỉ phần số, ví dụ 1234567890 (không có "act_")

# REC0 mặc định cho buoc3 khi gọi không tham số (thường để trống, hệ thống tự tìm):
REC0_DEFAULT=
