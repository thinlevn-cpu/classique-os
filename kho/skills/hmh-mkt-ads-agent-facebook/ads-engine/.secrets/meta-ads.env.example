# .secrets/meta-ads.env  — TOKEN META CỦA BẠN (copy thành meta-ads.env, bỏ .example)
# Lấy access token (System User token, quyền ads_management + pages_*) từ:
#   business.facebook.com -> Cài đặt doanh nghiệp -> Người dùng hệ thống -> Tạo token.
# TUYỆT ĐỐI không chia sẻ file này. Engine luôn tạo chiến dịch ở trạng thái PAUSED.

META_ACCESS_TOKEN=DIEN_TOKEN_DAI_CUA_BAN
META_AD_ACCOUNT_ID=act_DIEN_AD_ACCOUNT_ID    # nhớ có tiền tố act_
META_API_VERSION=v24.0
