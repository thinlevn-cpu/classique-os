#!/usr/bin/env python3
"""Chuẩn hoá ảnh bài viết về CÙNG khung 4:3 (1600x1200) để bố cục bài cân đối.
Dùng: python3 anh-4x3.py <spec.json> <out_dir>
spec.json = [{"src":"a.jpg","out":"slug-2-oc-vit.jpg","cx":0.5,"cy":0.5}, ...]  (cx,cy = tâm cắt, 0..1)
Cần Pillow (có sẵn trong ~/.claude/skills/seo/.venv)."""
import sys,json,os
from PIL import Image, ImageOps
W,H=1600,1200
spec=json.load(open(sys.argv[1])); out_dir=sys.argv[2]; os.makedirs(out_dir,exist_ok=True)
for it in spec:
    im=ImageOps.exif_transpose(Image.open(it['src'])).convert('RGB'); w,h=im.size
    cw=min(w,int(h*4/3)); ch=int(cw*3/4)
    cx=int(it.get('cx',0.5)*w); cy=int(it.get('cy',0.5)*h)
    x0=max(0,min(w-cw,cx-cw//2)); y0=max(0,min(h-ch,cy-ch//2))
    c=im.crop((x0,y0,x0+cw,y0+ch)).resize((W,H),Image.LANCZOS)
    c.save(os.path.join(out_dir,it['out']),quality=86,optimize=True); print(it['out'],(w,h),'->',(W,H))
