# ============================================================
# CONFIG — hmh-AIOS-enrich-ho-so-khach
# Copy file này thành `config.env` rồi điền giá trị của BẠN.
# File `config.env` đã nằm trong .gitignore — KHÔNG commit.
# Ở đây KHÔNG có secret: lark-cli tự dùng token trong keychain sau khi bạn đăng nhập.
# ============================================================

# --- Base & bảng lead salepage cần dựng hồ sơ ---
# Lấy từ URL Lark Base của bạn:
#   https://<tenant>.larksuite.com/base/<BASE_TOKEN>?table=<TABLE_ID>&view=<VIEW_ID>
BASE_TOKEN=bascnXXXXXXXXXXXXXXXXXXXXXX
TABLE_ID=tblXXXXXXXXXXXX
IDENTITY=user            # user | bot

# --- Tên các cột NGUỒN đã có sẵn trong bảng (đầu vào) ---
# Đổi cho khớp tên cột trong bảng của bạn.
F_HOTEN=Họ tên
F_SDT=Số điện thoại
F_EMAIL=Email
F_NGUON=Nguồn
F_GHICHU=Ghi chú

# --- Tên các cột kết quả (script tự tạo bằng 00-ensure-fields.mjs) ---
F_DA_ENRICH=Đã enrich
F_CHATLUONG=Chất lượng data
F_CO_KD=Có kinh doanh
F_NGANHNGHE=Ngành nghề
F_DKKD=Đăng ký KD
F_HOSO=Hồ sơ khách
F_TINCAY=Độ tin cậy
F_NGUON_ENRICH=Nguồn enrich
F_GOCTUVAN=Góc tư vấn
F_LINK=Link hồ sơ
F_DA_BAO_SALE=Đã báo sale

# --- Báo sale: mỗi khách MỘT card vào nhóm Lark ---
# Lấy: mở nhóm Lark → Cài đặt → Bots → Add bot → Custom Bot → copy Webhook URL.
SALE_WEBHOOK=https://open.larksuite.com/open-apis/bot/v2/hook/XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX

# Webhook báo tiến độ chạy (có thể để trống, hoặc dùng chung SALE_WEBHOOK).
NOTIFY_WEBHOOK=

# Link mở thẳng bản ghi trong Base — ghép record_id vào cuối (giữ nguyên dấu = ở cuối).
BASE_URL=https://<tenant>.larksuite.com/base/<BASE_TOKEN>?table=<TABLE_ID>&view=<VIEW_ID>&record=

# --- Nhận diện email nhà cung cấp miễn phí (không phải tín hiệu doanh nghiệp) ---
FREE_EMAIL_DOMAINS=gmail.com,gmail.con,gmail.comn,gmai.com,gmial.com,gnail.com,gmail.co,googlemail.com,yahoo.com,yahoo.com.vn,ymail.com,icloud.com,me.com,hotmail.com,hotmail.com.vn,outlook.com,outlook.com.vn,live.com,msn.com,protonmail.com,proton.me,zoho.com,aol.com,fpt.com.vn,email.com

# ============================================================
# TRẢ LỜI TRONG CHUỖI (thread) — thêm 18/08/2026
# ------------------------------------------------------------
# Thay vì gửi card rời, script tìm đúng tin "Data <nguồn> | <tên>" mà Base Assistant
# đã đăng trong nhóm rồi TRẢ LỜI VÀO CHUỖI tin đó — sale đọc liền mạch một chỗ.
# Không tìm được tin gốc hoặc reply lỗi → tự rơi về SALE_WEBHOOK, không mất hồ sơ.
# ============================================================

# App ID của bot (dạng cli_…) — chỉ cần cho 41-bat-tra-loi-trong-chuoi.mjs.
# Lấy ở Developer Console → App của bạn → Credentials & Basic Info.
APP_ID=

# ID nhóm Lark nhận data (dạng oc_…). Lấy: lark-cli im +chat-list --as user
SALE_CHAT_ID=

# true = bật trả lời trong chuỗi. Để trống/false = luôn gửi card rời qua webhook.
REPLY_IN_THREAD=false

# Quét bao nhiêu trang lịch sử nhóm (50 tin/trang) để tìm tin gốc.
THREAD_SCAN_PAGES=6

# Danh tính gửi reply: bot | user. Bot phải là THÀNH VIÊN nhóm, nếu không sẽ tự lùi về user.
# Nhóm liên hệ ngoài (external) chặn cả bot lẫn user — xem phần "Bẫy đã gặp" trong SKILL.md.
REPLY_IDENTITY=bot

# true = card rút gọn (3 dòng nhận diện + nút mở bản ghi), hồ sơ đầy đủ đọc trong Base.
CARD_GON=false

# ============================================================
# GOOGLE VIỆT NAM (25-google-vn.mjs) — TUỲ CHỌN, CÓ TÍNH PHÍ
# ------------------------------------------------------------
# Không đặt trong file này. Script đọc biến môi trường APIFY_TOKEN,
# hoặc file `.secrets/apify.env` ở thư mục làm việc (đi ngược lên tìm).
# Phí đo thật: ~$0,0042 mỗi truy vấn. Chạy `--dry` để xem trước số query và ước phí.
# ============================================================
