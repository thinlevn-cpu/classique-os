# Khoá của Classique OS. Thường KHÔNG cần sửa tay: nhập ở trang Kết nối, OS tự ghi vào .env (chmod 600).
# File này chỉ để biết có những khoá nào.

# Lark Base: app nội bộ (open.larksuite.com > Developer Console) có quyền bitable, đã được thêm vào Base
LARK_BASE_APP_ID=
LARK_BASE_APP_SECRET=
LARK_BASE_TOKEN=            # đoạn sau /base/ trong link Base
# LARK_API_HOST=https://open.larksuite.com   # Feishu: https://open.feishu.cn

# Pancake POS
PANCAKE_SHOP_ID=
PANCAKE_API_KEY=

# Meta Ads
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=         # dạng act_123...
# META_API_VERSION=v24.0

# WordPress (Application Password, không phải mật khẩu đăng nhập)
WP_URL=
WP_USER=
WP_APP_PASSWORD=

# Địa chỉ công khai của OS khi deploy (vd https://os.ten-mien-cua-ban.vn), dùng làm Referer cho OpenRouter
OS_PUBLIC_URL=
# OS_SECRET tự sinh ở lần chạy đầu, đừng chia sẻ
